cabal-version:      3.0
name:               haskellaula
version:            0.3.0.0
synopsis:           Guerra Fria 1962: jogo de estratégia por turnos em Haskell + Servant
maintainer:         isabellamasellialves@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

common warnings
    ghc-options: -Wall

common extensoes
    default-language:   Haskell2010
    default-extensions: OverloadedStrings
                        ScopedTypeVariables
                        FlexibleInstances
                        FlexibleContexts
                        MultiParamTypeClasses
                        DeriveGeneric

executable haskellaula
    import:           warnings
    import:           extensoes
    main-is:          Main.hs
    other-modules:    Model
                      Db
                      Api.Partidas
                      Game.Types
                      Game.Geografia
                      Game.Map
                      Game.Crises
                      Game.Rules
                      Game.Enigma
                      Web.Bandeiras
                      Web.Cenas
                      Web.Views
                      Web.Server
    build-depends:    base, servant, servant-server, warp,
                      aeson, bytestring, containers, http-api-data, http-media,
                      lucid, postgresql-simple, text, time
    hs-source-dirs:   app
    ghc-options:      -threaded

-- Testes das regras do jogo:  cabal test
test-suite testes
    import:           warnings
    import:           extensoes
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test, app
    other-modules:    Game.Types
                      Game.Geografia
                      Game.Map
                      Game.Crises
                      Game.Rules
                      Game.Enigma
    build-depends:    base, containers, text, hspec, QuickCheck
